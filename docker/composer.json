{
    "name": "flarum/flarum",
    "description": "Delightfully simple forum software.",
    "type": "project",
    "keywords": [
        "forum",
        "discussion"
    ],
    "homepage": "https://flarum.org/",
    "license": "MIT",
    "authors": [
        {
            "name": "Flarum",
            "email": "info@flarum.org",
            "homepage": "https://flarum.org/team"
        }
    ],
    "prefer-stable": true,
    "minimum-stability": "stable",
    "support": {
        "issues": "https://github.com/flarum/core/issues",
        "source": "https://github.com/flarum/flarum",
        "docs": "https://flarum.org/docs/"
    },
    "require": {
        "askvortsov/flarum-checklist": "*",
        "askvortsov/flarum-markdown-tables": "*",
        "askvortsov/flarum-rich-text": "*",
        "blomstra/cache-assets": "*",
        "blomstra/database-queue": "*",
        "flarum/approval": "*",
        "flarum/audit": "*",
        "flarum/bbcode": "*",
        "flarum/core": "^1.8.20",
        "flarum/emoji": "*",
        "flarum/flags": "*",
        "flarum/lang-english": "*",
        "flarum/likes": "*",
        "flarum/lock": "*",
        "flarum/markdown": "*",
        "flarum/mentions": "*",
        "flarum/nicknames": "*",
        "flarum/statistics": "*",
        "flarum/sticky": "*",
        "flarum/subscriptions": "*",
        "flarum/suspend": "*",
        "flarum/tags": "*",
        "flectar/flarum-fancybox": "*",
        "floxum/spam-prevention": "*",
        "fof/analytics": "*",
        "fof/anti-spam": "*",
        "fof/byobu": "*",
        "fof/drafts": "*",
        "fof/filter": "*",
        "fof/follow-tags": "*",
        "fof/formatting": "*",
        "fof/ignore-users": "*",
        "fof/links": "*",
        "fof/moderator-notes": "*",
        "fof/nightmode": "*",
        "fof/oauth": "*",
        "fof/pages": "*",
        "fof/secure-https": "*",
        "fof/sentry": "*",
        "fof/sitemap": "*",
        "fof/upload": "*",
        "fof/user-bio": "*",
        "nearata/flarum-ext-internal-links-noreload": "*",
        "sentry/sdk": "*",
        "sycho/flarum-move-posts": "*",
        "v17development/flarum-seo": "^2.0"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
	    "policy": {
        "advisories": {
            "ignore-id": {
                "PKSA-w9tt-7782-78jx": {
                    "on-block": false,
                    "reason": "No patched flysystem 1.x exists; flarum/core 1.8 pins ^1.0.11."
                },
                "PKSA-pwh8-d4fr-nywn": {
                    "on-block": false,
                    "reason": "No patched flysystem 1.x exists; flarum/core 1.8 pins ^1.0.11."
                },
                "GHSA-cxf4-7mrp-vvpr": {
                    "on-block": false,
                    "reason": "Same flysystem advisory chain, 1.x has no fix."
                }
            }
        }
    }
    },
    "minimum-stability": "stable",
    "repositories": [{
        "name": "floxum",
        "type": "composer",
        "url": "https://floxum.com/composer",
        "canonical": false
    }]
}
